# Seguridad básica (Apache / hosting cPanel)
Options -Indexes

# Nadie puede abrir directamente la configuración ni las funciones
<FilesMatch "^(config|db|funciones)\.php$">
    Require all denied
</FilesMatch>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Fotos grandes desde el celular
# (solo funciona si PHP corre como módulo de Apache; si tu hosting usa PHP-FPM, sube el límite
#  en cPanel -> "Seleccionar versión de PHP" -> Opciones: upload_max_filesize 16M, post_max_size 64M)
<IfModule mod_php7.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>
